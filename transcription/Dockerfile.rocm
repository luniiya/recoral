# Opt-in GPU variant: builds whisper.cpp from source with the ROCm/HIP
# backend, targeting gfx1100/gfx1101 (RX 7900 XTX / RX 7800 XT) by default.
# No official prebuilt ROCm image exists for whisper.cpp (ggml-org only
# ships CPU/CUDA/Vulkan variants), so this compiles from source against
# ROCm's own HIP toolchain instead.
#
# NOT the default (see ./Dockerfile for that): the real first deployment
# target for this project turned out to have no GPU at all, discovered only
# after assuming ROCm/HIP hardware up front, so CPU is what everyone gets
# unless they deliberately opt into this file (see hwaccel.transcription.yml
# and the commented block in docker-compose.yml for how to enable it).
FROM rocm/dev-ubuntu-22.04:6.2

ARG AMDGPU_TARGETS="gfx1100;gfx1101"

# hipblas-dev/rocblas-dev: ggml's HIP backend `find_package(hipblas)`s and
# `find_package(rocblas)`s at configure time (ggml-hip/CMakeLists.txt), but
# rocm/dev-ubuntu-22.04's "dev" image doesn't actually bundle either
# package's CMake config despite the name, so without them configure fails
# outright before any compilation even starts. hipblas-dev alone got past
# the hipblas check but then hit the same missing-package error for
# rocblas, hipblas's own dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
		git cmake build-essential ffmpeg ca-certificates curl unzip \
		hipblas-dev rocblas-dev \
	&& rm -rf /var/lib/apt/lists/*

# Bun runs the thin HTTP wrapper (server.ts) around the whisper-cli binary.
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app
RUN git clone --depth 1 https://github.com/ggml-org/whisper.cpp.git whisper.cpp
WORKDIR /app/whisper.cpp
# ggml's HIP vendor shim (ggml-cuda/vendors/hip.h) unconditionally uses
# __hip_fp8_e4m3 whenever HIP_VERSION >= 6.2, assuming every target that new
# has real FP8 hardware support. It doesn't: AMD's own hip_fp8.h only
# defines that class for gfx942/gfx1200/gfx1201/gfx950 (CDNA3, RDNA4), which
# excludes gfx1100/gfx1101 (RDNA3, our actual AMDGPU_TARGETS above) even on
# the newest ROCm. Compiling for those targets hits a hard "unknown type
# name '__hip_fp8_e4m3'" with no build flag to opt out, so this patches
# ggml's check to match AMD's own gating instead of blindly trusting the
# HIP version.
RUN sed -i \
	's/#if HIP_VERSION >= 60200000/#if HIP_VERSION >= 60200000 \&\& (defined(__gfx942__) || defined(__gfx1200__) || defined(__gfx1201__) || defined(__gfx950__))/' \
	ggml/src/ggml-cuda/vendors/hip.h
RUN cmake -B build -DGGML_HIP=1 -DAMDGPU_TARGETS="${AMDGPU_TARGETS}" -DCMAKE_BUILD_TYPE=Release \
	&& cmake --build build --config Release -j"$(nproc)"

WORKDIR /app
COPY package.json ./
RUN bun install --production
COPY server.ts ./

ENV MODELS_DIR=/models
ENV WHISPER_CLI=/app/whisper.cpp/build/bin/whisper-cli
ENV PORT=8090

EXPOSE 8090
CMD ["bun", "run", "server.ts"]
